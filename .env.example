# APP_URL: The URL where this applet is hosted.
APP_URL="https://vedikawellness.com"

# ADMIN_PASSCODE: Passcode for the /admin visitor & lead dashboard.
# If left empty, you can set your admin password directly on first visit to /admin.
ADMIN_PASSCODE=

# Optional automatic lead notifications (only sent when a submission includes phone or email):
# RESEND_API_KEY: Sends instant lead emails to vedikawellness01@gmail.com via Resend API
RESEND_API_KEY=
RESEND_FROM_EMAIL="Vedika Wellness <onboarding@resend.dev>"

# TELEGRAM_BOT_TOKEN & TELEGRAM_CHAT_ID: Sends instant Telegram alerts to coach (+91 81939 89452)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LEAD_WEBHOOK_URL: Optional HTTPS webhook (e.g. Make/Zapier/WhatsApp Business Cloud)
LEAD_WEBHOOK_URL=
